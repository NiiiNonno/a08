{
  "manifest_version": 3,
  "name": "a08 註",
  "short_name": "a08",
  "version": "0.1.0",
  "description": "Web ページへの註を Obsidian の vault に保存し、サイドパネルでノートを表示・編集します。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "sidePanel", "alarms", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "a08 註",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "annotate-selection": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "選択範囲に註をつける"
    }
  }
}
